# Copy to backend/.env and edit. Every key is optional; defaults are shown.
# Keys are case-insensitive.

# Currency the account is denominated in. Changing it converts an existing account at
# the live rate when the app starts.
BASE_CURRENCY=INR
# Cash a new account starts with, in the base currency.
STARTING_CASH=1000000
# "yahoo" (live data) or "fake" (offline, deterministic).
MARKET_DATA_PROVIDER=yahoo
# How long a quote is cached, in seconds.
QUOTE_CACHE_TTL_SECONDS=30
# How long historical bars are cached, in seconds.
BARS_CACHE_TTL_SECONDS=300
# Behind HTTPS (a deployment): only send the session cookie over HTTPS.
# COOKIE_SECURE=true
# A public server: refuse uploaded and editor code, cap sandbox processes. See docs/DEPLOY.md.
# HOSTED_MODE=true
# MAX_SANDBOXES=2
# Defaults to backend/data/app.db. Point at a scratch file to test destructive things.
# DATABASE_URL=sqlite:///C:/path/to/scratch.db
